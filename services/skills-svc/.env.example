# Copy to .env (git-ignored) for `uv run uvicorn app.main:app --reload --port 8000`.
DATABASE_URL=postgresql://skillsieve_api:skillsieve_api@localhost:55432/skillsieve
INTERNAL_TOKEN=local-dev-internal-token
# From https://aistudio.google.com/apikey (free). Leave empty to run with extraction off (503).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# R2 async extraction: docker compose --profile async up -d. Empty = HTTP API only.
AMQP_URL=

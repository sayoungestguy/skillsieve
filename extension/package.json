    "test": "vitest run",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "jsdom": "25.0.1",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}

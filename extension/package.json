{
  "name": "@skillsieve/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SkillSieve Chrome extension (MV3): save the job post in the current tab",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node build.mjs",
